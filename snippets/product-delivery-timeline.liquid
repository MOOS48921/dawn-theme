{%- comment -%}
  Renders a 3-step delivery timeline with dynamic Dutch dates.
  Accepts: block (section block with headline/subtext settings)
{%- endcomment -%}

{%- assign nl_months = 'januari,februari,maart,april,mei,juni,juli,augustus,september,oktober,november,december' | split: ',' -%}
{%- assign today_month_num = 'now' | date: '%-m' | minus: 1 -%}
{%- assign tomorrow_ts = 'now' | date: '%s' | plus: 86400 -%}
{%- assign tomorrow_month_num = tomorrow_ts | date: '%-m' | minus: 1 -%}
{%- assign overmorrow_ts = 'now' | date: '%s' | plus: 172800 -%}
{%- assign overmorrow_month_num = overmorrow_ts | date: '%-m' | minus: 1 -%}
{%- assign today_date = 'now' | date: '%-d' | append: ' ' | append: nl_months[today_month_num] -%}
{%- assign tomorrow_date = tomorrow_ts | date: '%-d' | append: ' ' | append: nl_months[tomorrow_month_num] -%}
{%- assign overmorrow_date = overmorrow_ts | date: '%-d' | append: ' ' | append: nl_months[overmorrow_month_num] -%}

<div class="product-delivery">
  <div class="product-delivery__header">
    {%- if block.settings.headline != blank -%}
      <p class="product-delivery__headline">{{ block.settings.headline }}</p>
    {%- endif -%}
    {%- if block.settings.subtext != blank -%}
      <p class="product-delivery__subtext">{{ block.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <div class="product-delivery__timeline">
    <div class="product-delivery__step">
      <div class="product-delivery__step-icon">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2h2.5l2 8h7l1.5-5H5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="7.5" cy="14.5" r="1.2" fill="currentColor"/>
          <circle cx="13" cy="14.5" r="1.2" fill="currentColor"/>
        </svg>
      </div>
      <div class="product-delivery__step-line" aria-hidden="true"></div>
      <p class="product-delivery__step-label">Besteld</p>
      <p class="product-delivery__step-date">{{ today_date }}</p>
    </div>

    <div class="product-delivery__step">
      <div class="product-delivery__step-icon">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="4" width="11" height="9" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12 7.5h3l2 3V13h-5V7.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <circle cx="4" cy="13.5" r="1.5" fill="currentColor"/>
          <circle cx="14" cy="13.5" r="1.5" fill="currentColor"/>
        </svg>
      </div>
      <div class="product-delivery__step-line" aria-hidden="true"></div>
      <p class="product-delivery__step-label">Verzonden</p>
      <p class="product-delivery__step-date">{{ tomorrow_date }}</p>
    </div>

    <div class="product-delivery__step">
      <div class="product-delivery__step-icon">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 2L2 6v6l7 4 7-4V6L9 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M2 6l7 4 7-4" stroke="currentColor" stroke-width="1.6"/>
          <line x1="9" y1="10" x2="9" y2="16" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </div>
      <p class="product-delivery__step-label">Geleverd</p>
      <p class="product-delivery__step-date">{{ overmorrow_date }}</p>
    </div>
  </div>
</div>
