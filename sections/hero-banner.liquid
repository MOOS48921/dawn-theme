{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-banner color-{{ section.settings.color_scheme }}">
  <div class="hero-banner__grid">

    <div
      class="hero-banner__text"
      style="--hero-padding-top: {{ section.settings.padding_top }}px; --hero-padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      {%- if section.settings.eyebrow_text != blank -%}
        <p class="hero-banner__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      <div class="hero-banner__divider" aria-hidden="true"></div>

      {%- if section.settings.button_primary_label != blank -%}
        <a
          href="{{ section.settings.button_primary_link | default: '#' }}"
          class="hero-banner__btn hero-banner__btn--primary"
        >
          {{ section.settings.button_primary_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="hero-banner__media">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'hero-banner__image' }}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Afbeelding"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurschema",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Kicker (kleine tekst boven titel)",
      "default": "WAAR KWALITEIT HEERST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "WELKOM BIJ PEPTIDESMEESTER"
    },
    {
      "type": "header",
      "content": "Knop"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Tekst",
      "default": "SHOP BUNDELS"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
