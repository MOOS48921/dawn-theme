{{ 'testimonials.css' | asset_url | stylesheet_tag }}

<div
  class="testimonials page-width color-{{ section.settings.color_scheme }}"
  style="--testimonials-padding-top: {{ section.settings.padding_top }}px; --testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="testimonials__grid">
    {%- for block in section.blocks -%}
      <div class="testimonials__card" {{ block.shopify_attributes }}>
        <div class="testimonials__rating">
          <span class="testimonials__rating-score">{{ block.settings.rating }}.0</span>
          <span class="testimonials__stars" aria-label="{{ block.settings.rating }} sterren">
            {%- for i in (1..5) -%}★{%- endfor -%}
          </span>
        </div>
        {%- if block.settings.title != blank -%}
          <p class="testimonials__card-title">{{ block.settings.title }}</p>
        {%- endif -%}
        <p class="testimonials__text">{{ block.settings.text }}</p>
        <div class="testimonials__footer">
          <p class="testimonials__name">{{ block.settings.author_name }}</p>
          {%- if block.settings.verified -%}
            <p class="testimonials__badge">
              <span class="testimonials__badge-icon">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              Geverifieerde koper
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Wat onze klanten zeggen"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Aantal sterren",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Reviewtekst"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Naam klant"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Toon 'Geverifieerde koper' badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
